---
import DocsLayout from "../layouts/DocsLayout.astro";
import {
	getDocsStaticPaths,
	getDocsPageProps,
	getSidebar,
	getPrevNext,
	getEditUrl,
	getLastUpdated,
	getTOC,
	getBreadcrumbs,
} from "@cloudflare/nimbus-docs";
import { config } from "virtual:nimbus/config";
import { components } from "../mdx-components";
import type { GetStaticPaths } from "astro";

export const prerender = true;
export const getStaticPaths = (async (...args: Parameters<typeof getDocsStaticPaths>) => {
	const paths = await getDocsStaticPaths(...args);
	return paths.filter((p) => p.params.slug !== "index");
}) satisfies GetStaticPaths;

const { entry, Content, headings } = await getDocsPageProps(Astro);

const currentSlug = Astro.url.pathname.replace(/\/$/, "") || "/";
const isSplash = entry.data.template === "splash";
const isCustom = entry.data.mode === "custom";
const isStandalone = isCustom || isSplash;
const sidebarOn =
	!isStandalone &&
	config.features?.sidebar !== false &&
	entry.data.sidebar !== false;
const tocOn =
	!isStandalone &&
	config.features?.tableOfContents !== false &&
	entry.data.tableOfContents !== false;

const sidebar = sidebarOn
	? await getSidebar(currentSlug, { collection: entry.collection })
	: false;

const prevNext = isSplash
	? {}
	: await getPrevNext(currentSlug, {
			sidebarTree: sidebar === false ? [] : sidebar,
			overrides: { prev: entry.data.prev, next: entry.data.next },
		});

const breadcrumbs = isSplash
	? []
	: await getBreadcrumbs(currentSlug, { collection: entry.collection });

const editUrl = await getEditUrl(entry);
const lastUpdated = entry.data.lastUpdated ?? (await getLastUpdated(entry));
const toc =
	tocOn && entry.data.tableOfContents !== false ? getTOC(headings) : false;
const markdownPath = `/${entry.id}/index.md`;
const markdownUrl = Astro.site
	? new URL(markdownPath, Astro.site).href
	: markdownPath;
---

<DocsLayout
	title={entry.data.title}
	description={entry.data.description}
	summary={entry.data.summary}
	sidebar={sidebar}
	headings={toc === false ? [] : toc}
	breadcrumbs={breadcrumbs}
	prevNext={prevNext}
	mode={entry.data.mode}
	banner={entry.data.banner}
	head={entry.data.head}
	noindex={entry.data.noindex}
	markdownUrl={markdownUrl}
	lastUpdated={lastUpdated}
	editUrl={editUrl}
	draft={entry.data.draft}
	collection={entry.collection}
	entryId={entry.id}
	wide={entry.data.wide}
	hideTitle={isSplash}
>
	<Content components={components} />
</DocsLayout>
