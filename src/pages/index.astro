---
import DocsLayout from "../layouts/DocsLayout.astro";
import {
	getDocsPageProps,
	getSidebar,
	getPrevNext,
	getEditUrl,
	getLastUpdated,
	getTOC,
	getBreadcrumbs,
} from "@cloudflare/nimbus-docs";
import { config } from "virtual:nimbus/config";
import { components } from "../mdx-components";
import { getCollection } from "astro:content";

export const prerender = true;

const docs = await getCollection("docs");
const home = docs.find((e) => e.id === "index");
if (!home) {
	throw new Error("Missing src/content/docs/index.mdx — required for /");
}

const { entry, Content, headings } = await getDocsPageProps({
	...Astro,
	props: { entry: home },
} as typeof Astro);

const currentSlug = "/";
const isCustom = entry.data.mode === "custom";
const sidebarOn =
	!isCustom &&
	config.features?.sidebar !== false &&
	entry.data.sidebar !== false;
const tocOn =
	!isCustom &&
	config.features?.tableOfContents !== false &&
	entry.data.tableOfContents !== false;

const sidebar = sidebarOn
	? await getSidebar(currentSlug, { collection: entry.collection })
	: false;

const prevNext = await getPrevNext(currentSlug, {
	sidebarTree: sidebar === false ? [] : sidebar,
	overrides: { prev: entry.data.prev, next: entry.data.next },
});

const breadcrumbs = await getBreadcrumbs(currentSlug, {
	collection: entry.collection,
});

const toc = tocOn ? getTOC(headings) : false;
const editUrl = await getEditUrl(entry);
const lastUpdated = entry.data.lastUpdated ?? (await getLastUpdated(entry));
const markdownUrl = Astro.site
	? new URL(`/${entry.id}/index.md`, Astro.site).href
	: `/${entry.id}/index.md`;
---

<DocsLayout
	title={entry.data.title}
	description={entry.data.description}
	summary={entry.data.summary}
	sidebar={sidebar}
	headings={toc === false ? [] : toc}
	breadcrumbs={breadcrumbs}
	prevNext={prevNext}
	mode={entry.data.mode}
	banner={entry.data.banner}
	head={entry.data.head}
	noindex={entry.data.noindex}
	markdownUrl={markdownUrl}
	lastUpdated={lastUpdated}
	editUrl={editUrl}
	draft={entry.data.draft}
	collection={entry.collection}
	entryId={entry.id}
>
	<Content components={components} />
</DocsLayout>
