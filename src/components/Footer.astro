---
import { config } from 'virtual:nimbus/config';

interface Props {
	class?: string;
}

const { class: className } = Astro.props;
const year = new Date().getFullYear();
const siteTitle = config.title ?? 'workers-world';
---

<footer
	class:list={['border-border text-muted-foreground border-t px-4 py-8 text-sm lg:px-6', className]}
>
	<div
		class="mx-auto flex w-full max-w-[1400px] flex-col items-start justify-between gap-4 sm:flex-row sm:items-center"
	>
		<p class="m-0">© {year} {siteTitle}</p>
		{
			config.github && (
				<a
					href={config.github}
					target="_blank"
					rel="noopener"
					class="text-muted-foreground hover:text-foreground no-underline transition-colors"
				>
					GitHub
				</a>
			)
		}
	</div>
</footer>
