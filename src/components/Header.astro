---
import Icon from "@cloudflare/nimbus-docs/components/Icon.astro";
import { config } from "virtual:nimbus/config";
import { getSidebarSections } from "@cloudflare/nimbus-docs";
import { Button } from "@/components/ui/button";
import { LinkButton } from "@/components/ui/link-button";
import { ThemeToggle } from "@/components/ui/theme-toggle";
import { SearchTrigger } from "@/components/ui/search";

interface Props {
	collection?: string;
	entryId?: string;
	showSidebar?: boolean;
}

const { collection, showSidebar = true } = Astro.props;

const siteTitle = config.title ?? "workers-world";
const currentSlug = Astro.url.pathname.replace(/\/$/, "") || "/";
const sections = await getSidebarSections(currentSlug, { collection });
---

<header class="border-border sticky top-0 z-30 border-b">
	<div
		aria-hidden="true"
		class="bg-card/80 pointer-events-none absolute inset-0 backdrop-blur-lg"
	>
	</div>
	<div
		class="relative mx-auto flex h-14 items-center justify-between px-4 lg:px-6"
	>
		<div class="flex items-center gap-3">
			<a
				href="/"
				aria-label={siteTitle}
				class="group flex items-center gap-2 no-underline lg:w-[calc(var(--nb-sidebar-width)-3.25rem-1px)] lg:shrink-0"
			>
				<span
					class="text-foreground group-hover:text-primary text-sm font-semibold transition-colors"
				>
					{siteTitle}
				</span>
				<span
					class="text-foreground/70 border-border-strong hidden rounded-md border px-1.5 py-0.5 text-[11px] leading-none font-semibold tracking-[0.08em] uppercase sm:inline-block"
				>
					Docs
				</span>
			</a>

			{
				sections.length > 0 && (
					<nav
						aria-label="Sections"
						class="border-border ml-4 hidden h-6 items-center gap-1 border-l pl-4 md:flex"
					>
						{sections.map((section) => (
							<a
								href={section.href}
								aria-current={section.isActive ? "page" : undefined}
								class:list={[
									"rounded-md px-2 py-1 text-[0.8125rem] font-medium no-underline transition-colors",
									section.isActive
										? "text-foreground bg-accent"
										: "text-muted-foreground hover:text-foreground hover:bg-accent/60",
								]}
							>
								{section.label}
							</a>
						))}
					</nav>
				)
			}
		</div>

		<div class="flex items-center gap-2">
			{config.search !== false && <SearchTrigger />}
			{
				config.github && (
					<LinkButton
						href={config.github}
						variant="ghost"
						shape="square"
						aria-label="GitHub"
						target="_blank"
						rel="noopener"
						class="text-muted-foreground hidden sm:flex"
					>
						<Icon name="ph:github-logo" class="h-4 w-4" />
					</LinkButton>
				)
			}
			<ThemeToggle />
			{
				showSidebar && (
					<Button
						variant="ghost"
						shape="square"
						icon="ph:list"
						aria-label="Open navigation"
						data-menu-btn
						class="text-muted-foreground lg:hidden"
					/>
				)
			}
		</div>
	</div>
</header>
